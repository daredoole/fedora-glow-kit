{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/dog.png",
    "width": 42,
    "height": 20,
    "preserveAspectRatio": true,
    "padding": {
      "top": 2,
      "left": 4,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 18
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────── Hardware ──────────────────────┐",
      "outputColor": "red"
    },
    {
      "type": "title",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "host",
      "key": "│ ├󰌢 Host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰍛 CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛 Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "└ └󰁹 Battery",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
      "outputColor": "red"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────── Software ──────────────────────┐",
      "outputColor": "red"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "version",
      "key": "└ └󰈙 Fastfetch",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
      "outputColor": "red"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────── Desktop ───────────────────────┐",
      "outputColor": "red"
    },
    {
      "type": "display",
      "key": " Display",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "│ ├ DE",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼 WM Theme",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": "└ └󰉼 App Theme",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
      "outputColor": "red"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────── Terminal Tools ──────────────────┐",
      "outputColor": "red"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├ Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "terminalfont",
      "key": "│ ├ Font",
      "keyColor": "cyan"
    },
    {
      "type": "editor",
      "key": "│ ├ Editor",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "│ ├ Starship",
      "keyColor": "cyan",
      "text": "starship --version | awk 'NR==1 {print $2}'"
    },
    {
      "type": "command",
      "key": "└ └󰛢 Atuin",
      "keyColor": "cyan",
      "text": "command -v atuin >/dev/null 2>&1 && atuin --version | awk '{print $2}' || printf 'not installed'"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
      "outputColor": "red"
    },
    "break",
    {
      "type": "locale",
      "key": "󰗊 Locale",
      "keyColor": "red"
    },
    "colors"
  ]
}
